# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).
# Docker Compose reads .env automatically.

DB_PASSWORD=change-me

# Long random string for CSRF tokens. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET=

# Keep true when the site is served over HTTPS. Use false only to demo over plain http://localhost.
COOKIE_SECURE=false

# T15: passphrase for the encrypted backups (docker-compose.backup.yml). Keep it apart from the backups.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14
