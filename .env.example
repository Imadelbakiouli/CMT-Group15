# Copy this file to .env and fill it in. Never commit .env (it is in .gitignore).
# Docker Compose reads .env automatically.

DB_PASSWORD=change-me        # fine on your own computer, use a real password anywhere else

# Long random string for CSRF tokens. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET=

# Keep true when the site is served over HTTPS. Use false only to demo over plain http://localhost.
COOKIE_SECURE=false

# T15: passphrase for the encrypted backups (docker-compose.backup.yml). Keep it apart from the backups.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14


# T13: who understands what users type to the AI assistant.
#   rules  = fixed sentences, no language model, no key (default)
#   gemini = Google Gemini, free text. Get a key at https://aistudio.google.com -> Get API key.
#            The free tier may use the sentences to improve Google's products: demo data only.
AI_PLANNER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
